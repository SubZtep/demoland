{
  "name": "demoland",
  "version": "1.0.0",
  "description": "",
  "author": "Andras Serfozo <subztep@gmail.com>",
  "repository": "github:SubZtep/demoland",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "viewer",
    "web"
  ],
  "scripts": {
    "dev": "pnpm --parallel --if-present dev",
    "build": "pnpm --recursive --if-present run build",
    "build:server": "pnpm --filter server run build",
    "build:web": "pnpm --filter web run build",
    "lint": "pnpm --recursive --if-present run lint",
    "test": "vitest"
  },
  "dependencies": {
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/lodash": "^4.14.199",
    "@types/node": "^20.8.6",
    "@typescript-eslint/eslint-plugin": "^6.7.5",
    "@typescript-eslint/parser": "^6.7.5",
    "eslint": "^8.51.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-tsdoc": "^0.2.17",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2",
    "vitest": "^0.34.6"
  }
}
