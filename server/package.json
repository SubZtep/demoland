  "main": "dist/index.js",
  "scripts": {
    "dev": "rm -rf ./dist && pnpm run build && pnpm run \"/^dev:.*/\"",
    "start": "node -r dotenv/config dist/index.js",
    "build": "node build.js --prod",
    "dev:build": "node build.js",
    "dev:start": "node -r dotenv/config dist/index.js",
    "watch:build": "node build.js --watch",
    "watch:start": "node --watch -r dotenv/config dist/index.js",
    "lint": "tsc --noEmit && eslint src",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.11.2",
