  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^20.4.5",
    "@types/ws": "^8.5.5",
    "dotenv": "^16.3.1",
    "esbuild": "^0.18.17",
    "globby": "^13.2.2",
    "typescript": "^5.1.6"
  }
